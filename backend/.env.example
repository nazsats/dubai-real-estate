# Copy to .env and fill in. Never commit the real .env.
# IMPORTANT: put your REAL key in .env (git-ignored), NOT here.

# ── Environment ───────────────────────────────────────────────
# "development" (default) or "production". Setting production turns on startup
# safety checks: a real SECRET_KEY, a non-SQLite database, and no demo seeding.
ENVIRONMENT=development

# Database. Fastest local option — SQLite (no install required):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Production — Supabase Postgres (the +asyncpg driver is added automatically).
# Copy the SESSION POOLER string from the dashboard verbatim. Note BOTH differences
# from the direct connection: the pooler host, and the postgres.<ref> username.
# The direct db.<ref>.supabase.co host is IPv6-only and fails with getaddrinfo
# errors on most networks. The aws-<n> prefix may be aws-0 or aws-1 depending on
# when the project was created. See docs/supabase-setup.md.
# DATABASE_URL=postgresql://postgres.<ref>:PASSWORD@aws-1-<region>.pooler.supabase.com:5432/postgres

# Postgres connection pool, per worker process. The real ceiling is
# (POOL_SIZE + MAX_OVERFLOW) x workers — keep it under your database plan's limit.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Auth — MUST be a long random string in production (`openssl rand -hex 32`).
# The app refuses to start in production while this is the shipped default.
SECRET_KEY=change-me-to-a-long-random-string

# Real Dubai listings — free key from rapidapi.com (search "Bayut" by ApiDojo). Optional.
RAPIDAPI_KEY=

# ── Cost controls ─────────────────────────────────────────────
# Default to the cheapest capable model (Haiku ~5x cheaper than Opus).
CLAUDE_MODEL=claude-haiku-4-5
# Optional higher-quality model for when you opt in per request (unused by default).
CLAUDE_SMART_MODEL=claude-sonnet-4-6
# Extended thinking costs extra tokens — off by default to save money.
USE_THINKING=false
# Cap output tokens per AI call (lower = cheaper).
AI_MAX_TOKENS=1500
# Reject AI calls beyond this many per minute, per agency. 0 = unlimited.
AI_RATE_LIMIT_PER_MINUTE=15

# ── Frontend / CORS ───────────────────────────────────────────
# Comma-separated list of exact frontend origins. No trailing slashes.
# Production example: https://your-app.vercel.app,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000
# Also accept Vercel's per-branch preview URLs (*.vercel.app).
ALLOW_VERCEL_PREVIEWS=true

# ── Other ─────────────────────────────────────────────────────
DEBUG=false
# Create tables on boot. Fine for now; set false once you write Alembic migrations.
AUTO_CREATE_TABLES=true
# Expose /docs and /redoc. Consider false in production.
ENABLE_DOCS=true
# Insert ~2,000 fake demo listings on first boot. Set false for a real database.
SEED_DEMO_DATA=true
SEED_PROPERTY_COUNT=2000
